# Telegram bot
TELEGRAM_TOKEN=

# Twitch Helix API
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch Chat Bot
TWITCH_BOT_NICK=
TWITCH_BOT_ID=
TWITCH_OAUTH=
TWITCH_CHAT_PREFIX=!

# Application
TWITCH_WEBAPP_URL=https://webapp.projectbw.ru/twitch/
CHECK_INTERVAL=30

# Optional proxy configuration (if supported by your deployment)
USE_PROXY=false

# Web API listener
WEB_HOST=0.0.0.0
WEB_PORT=1047

# Browser admin panel (runtime users are generated in data/admin/users.json)
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-this-to-a-long-random-password
WEB_USER1_USERNAME=
WEB_USER1_PASSWORD=
WEB_USER1_STREAMERS=
WEB_USER2_USERNAME=
WEB_USER2_PASSWORD=
WEB_USER2_STREAMERS=
BOT_DATA_DIR=data
